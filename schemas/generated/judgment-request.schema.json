{
  "$defs": {
    "CriterionJudgment": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "pattern": "^D(0[1-9]|1[0-2])\\.C[1-3]$",
          "title": "Criterion Id",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fact_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "supported",
            "not_supported",
            "insufficient",
            "conflicting",
            "not_applicable"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "outcome",
        "reason"
      ],
      "title": "CriterionJudgment",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "char_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "document_version_id",
        "page_number",
        "quote"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "judgments": {
      "items": {
        "$ref": "#/$defs/CriterionJudgment"
      },
      "minItems": 1,
      "title": "Judgments",
      "type": "array"
    },
    "reviewer": {
      "minLength": 1,
      "title": "Reviewer",
      "type": "string"
    },
    "rubric_version": {
      "const": "acm0002-quality-rubric-draft-v2",
      "default": "acm0002-quality-rubric-draft-v2",
      "title": "Rubric Version",
      "type": "string"
    }
  },
  "required": [
    "reviewer",
    "judgments"
  ],
  "title": "JudgmentRequest",
  "type": "object"
}
