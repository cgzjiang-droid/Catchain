{
  "$defs": {
    "CriterionJudgment": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "pattern": "^D(0[1-9]|1[0-2])\\.C[1-3]$",
          "title": "Criterion Id",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fact_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "supported",
            "not_supported",
            "insufficient",
            "conflicting",
            "not_applicable"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "outcome",
        "reason"
      ],
      "title": "CriterionJudgment",
      "type": "object"
    },
    "DimensionEvaluation": {
      "additionalProperties": false,
      "properties": {
        "criterion_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Criterion Ids",
          "type": "array"
        },
        "dimension_id": {
          "pattern": "^D(0[1-9]|1[0-2])$",
          "title": "Dimension Id",
          "type": "string"
        },
        "judgments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CriterionJudgment"
          },
          "title": "Judgments",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "reviewed_criterion_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reviewed Criterion Ids",
          "type": "array"
        },
        "score": {
          "default": null,
          "title": "Score",
          "type": "null"
        },
        "status": {
          "enum": [
            "unreviewed",
            "partially_reviewed",
            "unresolved",
            "reviewed_pending_policy"
          ],
          "title": "Status",
          "type": "string"
        },
        "unreviewed_criterion_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unreviewed Criterion Ids",
          "type": "array"
        },
        "weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        }
      },
      "required": [
        "dimension_id",
        "name",
        "criterion_ids",
        "status"
      ],
      "title": "DimensionEvaluation",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "char_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "document_version_id",
        "page_number",
        "quote"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "JudgmentRequest": {
      "additionalProperties": false,
      "properties": {
        "judgments": {
          "items": {
            "$ref": "#/$defs/CriterionJudgment"
          },
          "minItems": 1,
          "title": "Judgments",
          "type": "array"
        },
        "reviewer": {
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "rubric_version": {
          "const": "acm0002-quality-rubric-draft-v2",
          "default": "acm0002-quality-rubric-draft-v2",
          "title": "Rubric Version",
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "judgments"
      ],
      "title": "JudgmentRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dimensions": {
      "items": {
        "$ref": "#/$defs/DimensionEvaluation"
      },
      "maxItems": 12,
      "minItems": 12,
      "title": "Dimensions",
      "type": "array"
    },
    "input_readiness": {
      "additionalProperties": true,
      "title": "Input Readiness",
      "type": "object"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "model_calls": {
      "default": 0,
      "minimum": 0,
      "title": "Model Calls",
      "type": "integer"
    },
    "request": {
      "$ref": "#/$defs/JudgmentRequest"
    },
    "rubric_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rubric Sha256",
      "type": "string"
    },
    "rubric_status": {
      "minLength": 1,
      "title": "Rubric Status",
      "type": "string"
    },
    "rubric_version": {
      "const": "acm0002-quality-rubric-draft-v2",
      "title": "Rubric Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "score_status": {
      "const": "pending_policy",
      "title": "Score Status",
      "type": "string"
    },
    "total_score": {
      "default": null,
      "title": "Total Score",
      "type": "null"
    },
    "unreviewed_criteria": {
      "items": {
        "type": "string"
      },
      "title": "Unreviewed Criteria",
      "type": "array"
    }
  },
  "required": [
    "rubric_version",
    "rubric_sha256",
    "rubric_status",
    "request",
    "input_readiness",
    "unreviewed_criteria",
    "dimensions",
    "score_status",
    "limitations"
  ],
  "title": "EvaluationResult",
  "type": "object"
}
