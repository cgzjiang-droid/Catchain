{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "char_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "document_version_id",
        "page_number",
        "quote"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Registry": {
      "enum": [
        "acr",
        "gold_standard",
        "verra"
      ],
      "title": "Registry",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "format": "uuid",
      "title": "Candidate Id",
      "type": "string"
    },
    "current_fact_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Fact Id"
    },
    "decision_count": {
      "minimum": 0,
      "title": "Decision Count",
      "type": "integer"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "evidence_count": {
      "minimum": 0,
      "title": "Evidence Count",
      "type": "integer"
    },
    "field_name": {
      "minLength": 1,
      "title": "Field Name",
      "type": "string"
    },
    "issue_codes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Issue Codes",
      "type": "array"
    },
    "issues": {
      "default": [],
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Issues",
      "type": "array"
    },
    "latest_decision_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Decision At"
    },
    "priority": {
      "enum": [
        "critical",
        "high",
        "normal",
        "low"
      ],
      "title": "Priority",
      "type": "string"
    },
    "priority_reasons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Priority Reasons",
      "type": "array"
    },
    "priority_score": {
      "minimum": 0,
      "title": "Priority Score",
      "type": "integer"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "registry": {
      "$ref": "#/$defs/Registry"
    },
    "review_state": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "unresolved"
      ],
      "title": "Review State",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "validation_run_id": {
      "format": "uuid",
      "title": "Validation Run Id",
      "type": "string"
    },
    "validation_status": {
      "enum": [
        "missing",
        "rejected",
        "needs_review"
      ],
      "title": "Validation Status",
      "type": "string"
    },
    "value": {
      "default": null,
      "title": "Value"
    }
  },
  "required": [
    "candidate_id",
    "validation_run_id",
    "registry",
    "project_id",
    "field_name",
    "validation_status",
    "review_state",
    "priority",
    "priority_score",
    "evidence_count",
    "decision_count"
  ],
  "title": "ReviewQueueItem",
  "type": "object"
}
